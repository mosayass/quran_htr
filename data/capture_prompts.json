      "words_count": 6
    },
    {
      "id": "line_18",
      "mode": "line",
      "rasm": "ذلك لما متاع الحياة",
      "vowelled": "ذَٰلِكَ لَمَّا مَتَاعُ الْحَيَاةِ",
      "prompt_type": "rasm",

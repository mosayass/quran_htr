  "lines": [
    {
      "id": "line_01",
      "mode": "line",
      "rasm": "وقيل يا أرض ابلعي",
      "vowelled": "وَقِيلَ يَا أَرْضُ ابْلَعِي",
      "prompt_type": "vowelled",
      "surah": "سورة هود",
      "words_count": 4
    },
    {
      "id": "line_02",
      "mode": "line",
      "rasm": "وسبح بحمده وكفى به بذنوب عباده",
      "vowelled": "وَسَبِّحْ بِحَمْدِهِ وَكَفَىٰ بِهِ بِذُنُوبِ عِبَادِهِ",
      "prompt_type": "rasm",
      "surah": "سورة الفرقان",
      "words_count": 6
    },
    {
      "id": "line_03",
      "mode": "line",
      "rasm": "ولما ضرب ابن مريم مثلا إذا",
      "vowelled": "وَلَمَّا ضُرِبَ ابْنُ مَرْيَمَ مَثَلًا إِذَا",
      "prompt_type": "vowelled",
      "surah": "سورة الزخرف",
      "words_count": 6
    },
    {
      "id": "line_04",
      "mode": "line",
      "rasm": "صدورهم ليستخفوا منه ألا حين",
      "vowelled": "صُدُورَهُمْ لِيَسْتَخْفُوا مِنْهُ أَلَا حِينَ",
      "prompt_type": "rasm",
      "surah": "سورة هود",
      "words_count": 5
    },
    {
      "id": "line_05",
      "mode": "line",
      "rasm": "واصبر فإن الله لا يضيع أجر المحسنين",
      "vowelled": "وَاصْبِرْ فَإِنَّ اللَّهَ لَا يُضِيعُ أَجْرَ الْمُحْسِنِينَ",
      "prompt_type": "vowelled",
      "surah": "سورة هود",
      "words_count": 7
    },
    {
      "id": "line_06",
      "mode": "line",
      "rasm": "الشفاعة إلا من شهد بالحق وهم",
      "vowelled": "الشَّفَاعَةَ إِلَّا مَن شَهِدَ بِالْحَقِّ وَهُمْ",
      "prompt_type": "rasm",
      "surah": "سورة الزخرف",
      "words_count": 6
    },
    {
      "id": "line_07",
      "mode": "line",
      "rasm": "ويا قوم لا أسألكم",
      "vowelled": "وَيَا قَوْمِ لَا أَسْأَلُكُمْ",
      "prompt_type": "vowelled",
      "surah": "سورة هود",
      "words_count": 4
    },
    {
      "id": "line_08",
      "mode": "line",
      "rasm": "الرحيم يسبح لله ما",
      "vowelled": "الرَّحِيمِ يُسَبِّحُ لِلَّهِ مَا",
      "prompt_type": "rasm",
      "surah": "سورة الجمعة",
      "words_count": 4
    },
    {
      "id": "line_09",
      "mode": "line",
      "rasm": "وإن كلا لما ليوفينهم ربك أعمالهم إنه",
      "vowelled": "وَإِنَّ كُلًّا لَّمَّا لَيُوَفِّيَنَّهُمْ رَبُّكَ أَعْمَالَهُمْ إِنَّهُ",
      "prompt_type": "vowelled",
      "surah": "سورة هود",
      "words_count": 7
    },
    {
      "id": "line_10",
      "mode": "line",
      "rasm": "تعلنون والله عليم بذات الصدور",
      "vowelled": "تُعْلِنُونَ وَاللَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ",
      "prompt_type": "rasm",
      "surah": "سورة التغابن",
      "words_count": 5
    },
    {
      "id": "line_11",
      "mode": "line",
      "rasm": "عباد الله إني لكم رسول أمين",
      "vowelled": "عِبَادَ اللَّهِ إِنِّي لَكُمْ رَسُولٌ أَمِينٌ",
      "prompt_type": "vowelled",
      "surah": "سورة الدخان",
      "words_count": 6
    },
    {
      "id": "line_12",
      "mode": "line",
      "rasm": "والله أعلم بما يوعون",
      "vowelled": "وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَ",
      "prompt_type": "rasm",
      "surah": "سورة الانشقاق",
      "words_count": 4
    },
    {
      "id": "line_13",
      "mode": "line",
      "rasm": "أبصرنا وسمعنا فارجعنا نعمل صالحا إنا موقنون",
      "vowelled": "أَبْصَرْنَا وَسَمِعْنَا فَارْجِعْنَا نَعْمَلْ صَالِحًا إِنَّا مُوقِنُونَ",
      "prompt_type": "vowelled",
      "surah": "سورة السجدة",
      "words_count": 7
    },
    {
      "id": "line_14",
      "mode": "line",
      "rasm": "من تحتها الأنهار خالدين",
      "vowelled": "مِن تَحْتِهَا الْأَنْهَارُ خَالِدِينَ",
      "prompt_type": "rasm",
      "surah": "سورة التغابن",
      "words_count": 4
    },
    {
      "id": "line_15",
      "mode": "line",
      "rasm": "العلم إن ربك هو أعلم بمن",
      "vowelled": "الْعِلْمِ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن",
      "prompt_type": "vowelled",
      "surah": "سورة النجم",
      "words_count": 6
    },
    {
      "id": "line_16",
      "mode": "line",
      "rasm": "إليك إنك على صراط مستقيم",
      "vowelled": "إِلَيْكَ إِنَّكَ عَلَىٰ صِرَاطٍ مُّسْتَقِيمٍ",
      "prompt_type": "rasm",
      "surah": "سورة الزخرف",
      "words_count": 5
    },
    {
      "id": "line_17",
      "mode": "line",
      "rasm": "فمن الله علينا ووقانا عذاب السموم",
      "vowelled": "فَمَنَّ اللَّهُ عَلَيْنَا وَوَقَانَا عَذَابَ السَّمُومِ",
      "prompt_type": "vowelled",
